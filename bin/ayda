#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════
#  ӘЙДӘ (ayda) — Татарнетес идарә коралы / Tatarnetes control tool
#  Милли kubectl. Татарча әмерләр kubectl'га тәрҗемә ителә.
#  A national kubectl: Tatar commands are transparently translated to kubectl.
#
#  Тел / language : AYDA_LANG=tt|en      Язу / script : AYDA_ALIF=cyrl|latin|arab
#  Нигез / backend : AYDA_BACKEND=kubectl|skctl (Sheeternetes)
#  © Бөек татар халкына / to the great Tatar people — Tatarch License 2.0
# ═══════════════════════════════════════════════════════════════════════
set -uo pipefail

# Симлинклар аша да үз урыныңны тап (install.sh, krew симлинк ясый).
# Follow symlinks to the real file: install.sh and krew both link into PATH.
_self="${BASH_SOURCE[0]:-$0}"
while [ -L "$_self" ]; do
  _dir="$(cd "$(dirname "$_self")" && pwd)"; _self="$(readlink "$_self")"
  case "$_self" in /*) ;; *) _self="$_dir/$_self" ;; esac
done
AYDA_HOME="$(cd "$(dirname "$_self")/.." && pwd)"
LIB="$AYDA_HOME/lib"

for _m in render alif catalog i18n complete dictionary faces phrases teatime calendar finops errors skctl explain; do
  # shellcheck source=/dev/null
  . "$LIB/$_m.sh"
done

KUBECTL_BIN="${AYDA_KUBECTL:-kubectl}"
SKCTL_BIN="${AYDA_SKCTL:-skctl}"
AYDA_BACKEND="${AYDA_BACKEND:-kubectl}"
AYDA_VERSION="3.0.0"

# --- Декорацияләр / decorations -----------------------------------------
_footer_extras() {
  # Бәйрәм баннеры / festival banner
  local fest; fest="$(tat_festival)" || fest=""
  [ -n "$fest" ] && printf '%b\n' "  ${TAT_GOLD}${TAT_BOLD}$(t "$fest")${TAT_RESET}" >&2
  # Хуҗалыкчыллык / thrift nag
  local reps
  if reps="$(tat_finops_replicas ${kargs[@]+"${kargs[@]}"})"; then
    printf '%b\n' "  ${TAT_RED}$(t finops.nag "$reps")${TAT_RESET}" >&2
  fi
}

show_success_footer() {
  tat_fun_enabled || return 0
  tat_carpet
  tat_face_happy
  printf '%b\n' "  ${TAT_GREEN}${TAT_BOLD}$(tat_random_praise)${TAT_RESET}" >&2
  printf '%b\n' "${TAT_GOLD}$(tat_random_garnish)${TAT_RESET}" >&2
  _footer_extras
  tat_carpet
}

show_error_footer() {
  local rc="$1" errtext="${2:-}"
  tat_fun_enabled || return 0
  tat_carpet
  tat_face_angry
  printf '%b\n' "  ${TAT_RED}${TAT_BOLD}$(tat_random_curse)${TAT_RESET}  ${TAT_DIM}$(t err.code "$rc")${TAT_RESET}" >&2
  # kubectl/skctl хатасын татарча аңлату / translate the backend error
  local hint=""
  [ "$AYDA_BACKEND" = skctl ] && hint="$(skctl_error_hint "$errtext")"
  [ -z "$hint" ] && hint="$(tat_error_hint "$errtext")"
  [ -n "$hint" ] && printf '%b\n' "  ${TAT_GOLD}$(t "$hint")${TAT_RESET}" >&2
  _footer_extras
  tat_carpet
}

# --- Чәй тәнәфесе / tea break screen ------------------------------------
show_tea_break() {
  local left; left=$(tea_minutes_left)
  {
    tat_carpet
    tat_face_tea
    printf '%b\n' "${TAT_GOLD}${TAT_BOLD}  ⛔ $(t tea.title) ⛔${TAT_RESET}"
    printf '%s\n' "  ─────────────────────────────────────────────"
    printf '%s\n' "  $(t tea.body) 🍵🫓🥟🍯"
    printf '%s\n' ""
    printf '%s\n' "  $(t tea.retry "$left")"
    printf '%s\n' ""
    printf '%b\n' "  ${TAT_DIM}$(t tea.bypass)${TAT_RESET}"
    tat_carpet
  } >&2
}

# --- Кунакчыллык / hospitality: welcome a new context -------------------
current_context() {
  local a prev=""
  for a in ${kargs[@]+"${kargs[@]}"}; do
    case "$a" in
      --context=*) printf '%s' "${a#*=}"; return 0 ;;
      --context)   prev=1 ;;
      *) [ -n "$prev" ] && { printf '%s' "$a"; return 0; } ;;
    esac
  done
  "$KUBECTL_BIN" config current-context 2>/dev/null
}
maybe_welcome() {
  tat_fun_enabled || return 0
  local ctx cache f last=""
  ctx="$(current_context)"; [ -z "$ctx" ] && return 0
  cache="${XDG_CACHE_HOME:-$HOME/.cache}/ayda"; mkdir -p "$cache" 2>/dev/null || return 0
  f="$cache/last_ctx"
  [ -f "$f" ] && last="$(cat "$f" 2>/dev/null)"
  if [ "$ctx" != "$last" ]; then
    printf '%s' "$ctx" > "$f" 2>/dev/null || true
    printf '%b\n' "  ${TAT_GOLD}$(t welcome.newctx "$ctx")${TAT_RESET}" >&2
  fi
}

# --- Ярдәм / help --------------------------------------------------------
_help_tt() {
  cat <<HLP | alif_render
  ӘЙДӘ (ayda) — Татарнетес идарә коралы  v${AYDA_VERSION}
  Милли kubectl / a national kubectl.

  КУЛЛАНУ:
    ayda <фигыль> <асыл> [исем] [флаглар]

  МИСАЛЛАР:
    ayda күрсәт кузаклар               → kubectl get pods
    ayda күрсәт кузаклар -A            → kubectl get pods -A
    ayda сөйлә төен node-1             → kubectl describe node node-1
    ayda көндәлек my-pod              → kubectl logs my-pod
    ayda бетер хезмәт my-svc          → kubectl delete svc my-svc
    ayda аңлат кузак.spec             → глоссарий + kubectl explain pods.spec
    ayda get pods                     → гадәти kubectl та эшли

  Латинча да языла (кириллсыз клавиатура өчен):
    ayda kürsät kuzaklar              → kubectl get pods

  ЭЧКЕ ӘМЕРЛӘР:
    ayda ярдәм | сүзлек | версия
    ayda аңлат [төшенчә[.юл]]          татарча kubectl explain (глоссарий)
    ayda шигырь | тукай               классик поэзия
    ayda мәкаль                       халык мәкале
    ayda чәй | сәлам

  КӨЙЛӘМӘЛӘР (ENV):
    AYDA_LANG=tt|en          интерфейс теле
    AYDA_ALIF=cyrl|latin|arab  язу төре (кирилл/яңалиф/яңа имля)
    AYDA_KUBECTL=<юл>        kubectl юлы
    AYDA_BACKEND=kubectl|skctl  нигез: kubectl яки Sheeternetes (skctl)
    AYDA_SKCTL=<юл>          skctl юлы
    AYDA_NO_TEA=1            чәй тәнәфесен узып китү
    AYDA_FORCE_TEA=1         чәй экранын мәҗбүри күрсәтү (демо)
    AYDA_FINOPS_MAX=<сан>    реплика чиге (default 10)
    AYDA_COMPLETE_TIMEOUT=2s  Tab-тулыландыруда кластерны көтү чиге
    AYDA_PLAIN=1 | AYDA_QUIET=1 | AYDA_FORCE_FUN=1 | NO_COLOR=1

  ЧЫГУ КОДЛАРЫ: 0 уңыш · 64 әмер юк · 69 skctl белми · 42 чәй · 127 kubectl/skctl юк
HLP
}
_help_en() {
  cat <<HLP
  ayda — Tatarnetes control tool  v${AYDA_VERSION}
  A national kubectl: Tatar commands translated to kubectl.

  USAGE:
    ayda <verb> <resource> [name] [flags]

  EXAMPLES:
    ayda күрсәт кузаклар               → kubectl get pods
    ayda kürsät kuzaklar              → kubectl get pods (Latin input)
    ayda аңлат кузак.spec             → glossary + kubectl explain pods.spec
    ayda get pods                     → plain kubectl works too

  BUILT-INS:
    ayda ярдәм|help · сүзлек · версия|version
    ayda аңлат [term[.path]]          Tatar kubectl explain (glossary)
    ayda шигырь (poetry) · мәкаль (proverb) · чәй (tea) · сәлам (hi)

  ENV:
    AYDA_LANG=tt|en            interface language
    AYDA_ALIF=cyrl|latin|arab  writing system
    AYDA_KUBECTL=<path>        kubectl path
    AYDA_BACKEND=kubectl|skctl backend: kubectl or Sheeternetes (skctl)
    AYDA_SKCTL=<path>          skctl path
    AYDA_NO_TEA=1 · AYDA_FORCE_TEA=1 · AYDA_FINOPS_MAX=<n>
    AYDA_COMPLETE_TIMEOUT=2s   cluster timeout for Tab completion
    AYDA_PLAIN=1 · AYDA_QUIET=1 · AYDA_FORCE_FUN=1 · NO_COLOR=1

  EXIT CODES: 0 ok · 64 unknown verb · 69 not supported by skctl · 42 tea · 127 kubectl/skctl missing
HLP
}
show_help() { if [ "$AYDA_LANG" = "en" ]; then _help_en; else _help_tt; fi }

show_version() {
  tat_carpet
  tat_bold "  Татарнетес / Tatarnetes  v${AYDA_VERSION}"
  printf '%b\n' "  ${TAT_GREEN}$(t version.tagline)${TAT_RESET}" >&2
  printf '%b\n' "  ${TAT_DIM}$(t version.dedication)${TAT_RESET}" >&2
  if [ "$AYDA_BACKEND" = skctl ]; then
    printf '%b\n' "  ${TAT_DIM}$(t version.backend) skctl (Sheeternetes) — $SKCTL_BIN${TAT_RESET}" >&2
  elif command -v "$KUBECTL_BIN" >/dev/null 2>&1; then
    printf '%b\n' "  ${TAT_DIM}$(t version.backend)${TAT_RESET}" >&2
    "$KUBECTL_BIN" version --client 2>/dev/null | sed 's/^/    /' >&2 || true
  fi
  tat_carpet
}

print_poem()    { tat_carpet; printf '%b\n' "${TAT_GOLD}$(tat_random_poem)${TAT_RESET}" >&2; tat_carpet; }
print_proverb() { tat_carpet; printf '%b\n' "${TAT_GOLD}$(tat_random_proverb)${TAT_RESET}" >&2; tat_carpet; }

tea_status() {
  tat_carpet
  if tea_now; then
    tat_face_tea
    printf '%b\n' "  ${TAT_GOLD}$(t tea.now "$(tea_minutes_left)")${TAT_RESET}" >&2
  else
    printf '%b\n' "  ${TAT_GREEN}$(t tea.working "$(tea_next_hhmm)")${TAT_RESET}" >&2
  fi
  printf '%b\n' "  $(t tea.today)" >&2
  tea_windows | while read -r s d; do
    printf '    %02d:%02d  (%s мин)\n' $(( s / 60 )) $(( s % 60 )) "$d" >&2
  done
  tat_carpet
}

greet() {
  tat_carpet
  tat_face_happy
  printf '%b\n' "  ${TAT_GREEN}${TAT_BOLD}$(t greet.hello)${TAT_RESET}" >&2
  local fest; fest="$(tat_festival)" || fest=""
  [ -n "$fest" ] && printf '%b\n' "  ${TAT_GOLD}${TAT_BOLD}$(t "$fest")${TAT_RESET}" >&2
  printf '%b\n' "  ${TAT_GOLD}$(tat_random_poem)${TAT_RESET}" >&2
  tat_carpet
}

# --- Нигезне башкару (stderr тотып) / execute the backend, capturing stderr
# RUN_BIN + RUN_ARGS — тулысынча тәрҗемә ителгән әмер / the fully translated command.
RC=0; ERRTEXT=""
RUN_BIN=""; RUN_ARGS=()
run_backend() {
  local streaming=0 a
  case "$kverb" in
    exec|attach|port-forward|proxy|edit|debug|cp) streaming=1 ;;
    logs) for a in ${kargs[@]+"${kargs[@]}"}; do
            case "$a" in -f|--follow) streaming=1 ;; esac
          done ;;
  esac
  if [ "$streaming" -eq 1 ]; then
    "$RUN_BIN" "${RUN_ARGS[@]}"; RC=$?; ERRTEXT=""
  else
    { ERRTEXT="$("$RUN_BIN" "${RUN_ARGS[@]}" 2>&1 1>&3 3>&-)"; RC=$?; } 3>&1
    [ -n "$ERRTEXT" ] && printf '%s\n' "$ERRTEXT" >&2
  fi
}

# --- Төп агым / main ----------------------------------------------------
main() {
  if [ "$#" -eq 0 ]; then show_help; exit 0; fi

  local verb="$1"; shift    # builtin'нар өчен raw, kubectl юлында resolve_verb фолбэк бирә

  case "$verb" in
    __complete)                  ayda_complete "$@"; exit 0 ;;   # bash/zsh/kubectl Tab
    ярдәм|help|--help|-h)        show_help;    exit 0 ;;
    версия|version|--version)    show_version; exit 0 ;;
    сүзлек|dictionary|словарь)   show_dictionary | alif_render >&2; exit 0 ;;
    шигырь|тукай|поэзия|poem)    print_poem;   exit 0 ;;
    мәкаль|мәкальләр|proverb)    print_proverb; exit 0 ;;
    чәй|чай|tea)                 tea_status;   exit 0 ;;
    сәлам|salam|исәнме|привет|hi) greet;       exit 0 ;;
  esac

  case "$AYDA_BACKEND" in
    kubectl|skctl) ;;
    *) printf '%s\n' "$(t backend.unknown "$AYDA_BACKEND")" >&2; exit 64 ;;
  esac

  # «аңлат» — татарча explain; глоссарий чәй вакытында да ачык, схема — юк.
  # Tatar explain: the glossary works during tea; the kubectl schema step does not.
  if [ "$(complete_to_cyrl "$verb" аңлат)" = аңлат ]; then
    local erc=0
    explain_main "$@" || erc=$?
    [ "$erc" -eq 0 ] && show_success_footer
    exit "$erc"
  fi

  # Чәй капкасы / tea gate — cluster unreachable during tea (everywhere; AYDA_NO_TEA=1 to skip).
  if tea_now; then show_tea_break; exit 42; fi

  # Фигыльне тәрҗемә (латин фолбэк белән) / translate verb (Latin fallback).
  local kverb; kverb="$(resolve_verb "$verb")"
  # skctl'ның үз фигыльләре (migrate) / skctl-only verbs
  [ -z "$kverb" ] && [ "$AYDA_BACKEND" = skctl ] && kverb="$(skctl_resolve_verb "$verb")"
  if [ -z "$kverb" ]; then
    {
      tat_carpet; tat_face_angry
      printf '%b\n' "  ${TAT_RED}${TAT_BOLD}$(t err.unknown_verb "$verb")${TAT_RESET}"
      printf '%b\n' "  ${TAT_RED}$(tat_random_curse)${TAT_RESET}"
      printf '%b\n' "  $(t hint.try_help)"
      tat_carpet
    } >&2
    exit 64
  fi

  # Калган сүзләр: беренче позицион (асыл) — тәрҗемә; исем/флаг — тими.
  # Латинча кертемне дә кирилга кайтарабыз (translate_noun таба).
  local -a kargs=()
  local tok res_done=0
  for tok in "$@"; do
    case "$tok" in
      -*) kargs+=("$tok") ;;
      *)  if [ "$res_done" -eq 0 ]; then
            kargs+=("$(resolve_noun "$tok")"); res_done=1
          else
            kargs+=("$tok")
          fi ;;
    esac
  done

  if [ "$AYDA_BACKEND" = skctl ]; then
    # Sheeternetes: skctl белмәгәнне эшләтмибез / never run what skctl can't do as typed.
    if ! skctl_map "$kverb" ${kargs[@]+"${kargs[@]}"}; then
      {
        tat_carpet; tat_face_angry
        printf '%b\n' "  ${TAT_RED}${TAT_BOLD}$(t "$SKERR" ${SKERR_ARGS[@]+"${SKERR_ARGS[@]}"})${TAT_RESET}"
        printf '%s\n' "  $(t skctl.nothing_run)"
        tat_carpet
      } >&2
      exit 69
    fi
    RUN_BIN="$SKCTL_BIN"; RUN_ARGS=("${SKARGS[@]}")
  else
    RUN_BIN="$KUBECTL_BIN"; RUN_ARGS=("$kverb" ${kargs[@]+"${kargs[@]}"})
  fi

  tat_dim "🐘 $(t run.translated "$RUN_BIN ${RUN_ARGS[*]}")"

  if ! command -v "$RUN_BIN" >/dev/null 2>&1; then
    {
      tat_carpet; tat_face_angry
      printf '%b\n' "  ${TAT_RED}$(t "$AYDA_BACKEND.notfound" "$RUN_BIN")${TAT_RESET}"
      printf '%s\n' "  $(t "$AYDA_BACKEND.notfound.hint")"
      tat_carpet
    } >&2
    exit 127
  fi

  [ "$AYDA_BACKEND" = kubectl ] && maybe_welcome   # кунакчыллык / hospitality (kubeconfig contexts)

  run_backend                       # → RC, ERRTEXT

  if [ "$RC" -eq 0 ]; then
    show_success_footer
  else
    show_error_footer "$RC" "$ERRTEXT"
  fi
  exit "$RC"
}

main "$@"
