# --- Sheeternetes backend (AYDA_BACKEND=skctl) ---
msgid "backend.unknown"
msgstr "Unknown backend (AYDA_BACKEND): \"%s\". Allowed: kubectl, skctl."

msgid "skctl.notfound"
msgstr "skctl not found (%s)."

msgid "skctl.notfound.hint"
msgstr "Put Sheeternetes' skctl on PATH or set AYDA_SKCTL=<path>."

msgid "skctl.unsupported.verb"
msgstr "Sheeternetes (skctl) has no \"%s\". It knows: get, apply, scale, delete, cordon, uncordon, drain, label, taint, migrate."

msgid "skctl.unsupported.kind"
msgstr "skctl %s does not handle \"%s\" — only %s."

msgid "skctl.unsupported.flag"
msgstr "skctl has no \"%s\" flag."

msgid "skctl.usage"
msgstr "Sheeternetes form: %s"

msgid "skctl.nothing_run"
msgstr "Nothing was run — the cluster was not touched."

msgid "skctl.hint.env"
msgstr "WEBAPP_URL is not set — give the apiserver address via the environment or .skctl.env next to skctl."

msgid "skctl.hint.token"
msgstr "The apiserver refused (401) — is TOKEN correct?"

# --- `ayda аңлат` — a Tatar kubectl explain ---
msgid "explain.index"
msgstr "Glossary terms (docs/terminology.tt.md):"

msgid "explain.index.hint"
msgstr "To explain a term: ayda аңлат <term>[.path]  (e.g. ayda аңлат кузак.spec)"

msgid "explain.type"
msgstr "Kind of term: %s"

msgid "explain.kubectl"
msgstr "kubectl resource: %s"

msgid "explain.concept"
msgstr "A general concept, not a kubectl resource of its own."

msgid "explain.was_describe"
msgstr "«аңлат» now explains a resource kind (kubectl explain) and takes a single word. To describe an object: ayda сөйлә %s"

msgid "explain.unknown"
msgstr "No resource or glossary term «%s». List them: ayda аңлат"

msgid "explain.not_in_glossary"
msgstr "«%s» is not in the glossary — showing the kubectl schema only."

msgid "explain.no_schema"
msgstr "«%s» is a general concept; it has no kubectl field schema."

msgid "explain.skctl"
msgstr "Sheeternetes (skctl) has no explain — glossary entry only."

msgid "explain.no_field"
msgstr "Field «%s» does not exist. Available fields: ayda аңлат %s"

msgid "explain.schema_failed"
msgstr "Could not fetch the field schema (kubectl explain talks to the cluster). Glossary only: --кыскача"

# --- TatarOS kuberoot backend (TOS_BACKEND=kuberoot) ---
msgid "tos.backend.unknown"
msgstr "Unknown backend (TOS_BACKEND): \"%s\". Allowed: kuberoot, talos."

msgid "tos.kr.talos_only"
msgstr "\"%s\" is a Talos verb with no kuberoot counterpart. Try it with TOS_BACKEND=talos."

msgid "tos.kr.need_node"
msgstr "Several nodes are visible; name one with -n <node>."

msgid "tos.kr.need_service"
msgstr "Name the service: tos logs <service>."

msgid "tos.kr.need_url"
msgstr "A release is required: tos upgrade --url <URL> [--sha256 <hash>]."

msgid "tos.kr.no_spare_slot"
msgstr "There is no other slot to roll back to (%s)."

msgid "tos.kr.reboot"
msgstr "Node %s is rebooting."

msgid "tos.kr.upgrade"
msgstr "%s: upgrade started; watch it with \"tos get upgrades\"."

msgid "tos.kr.rollback"
msgstr "%s: rolling back to slot %s."

msgid "tos.kr.restart"
msgstr "Service %s is restarting."

# --- Tea windows as kuberoot rollout maintenance windows ---
msgid "tos.teawin.applied"
msgstr "Rollout %s now proceeds only during tea breaks: %s windows, %s days ahead."

msgid "tos.teawin.bad_days"
msgstr "Days must be between 1 and 60: \"%s\"."

msgid "tos.teawin.bad_tz"
msgstr "Unknown time zone: \"%s\"."

